---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import Tag from "@components/Tag.astro";
import Datetime from "@components/Datetime";
import PostActions from "@components/PostActions.astro";
import { SITE } from "@config";
import type { BlogFrontmatter } from "@lib/utils";

export interface Props {
  frontmatter: BlogFrontmatter;
}

const { frontmatter } = Astro.props;
const { title, author, description, ogImage, pubDatetime, tags, postSlug } = frontmatter;
---

<Layout title={title} author={author} description={description} ogImage={ogImage}>
  <Header />
  <div class="mx-auto flex w-full max-w-3xl justify-start px-2">
    <button
      class="focus-outline mt-8 mb-2 flex hover:opacity-75"
      onclick="history.back()"
    >
      <svg xmlns="http://www.w3.org/2000/svg"
        ><path
          d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"
        ></path>
      </svg><span>Go back</span>
    </button>
  </div>
  <main id="main-content">
    <h1 class="post-title">{title}</h1>
    <Datetime datetime={pubDatetime} size="lg" className="my-2" />
    <article id="article" role="article" class="prose mx-auto mt-8 max-w-3xl">
      <slot />
    </article>

    <ul class="tags-container">
      {tags.map(tag => <Tag name={tag} />)}
    </ul>

    <PostActions 
      postTitle={title} 
      postSlug={postSlug || ''} 
      postUrl={`${SITE.website}/posts/${postSlug || ''}`}
      tags={tags}
    />
  </main>
  <Footer />
</Layout>

<script is:inline type="text/javascript">
  document.addEventListener('DOMContentLoaded', function() {
    setTimeout(runMermaid, 2000);
  });

  function runMermaid() {
    if (typeof mermaid === 'undefined') {
      console.log('Mermaid undefined - CDN not loaded');
      return;
    }

    var pres = document.querySelectorAll('pre[data-language="mermaid"], pre code.language-mermaid');
    var targets = [];

    pres.forEach(function(el) {
      var pre = el.tagName === 'CODE' ? el.parentElement : el;
      if (pre) targets.push(pre);
    });

    targets = Array.from(new Set(targets));
    console.log('Mermaid: found', targets.length, 'diagram blocks');

    targets.forEach(function(pre, idx) {
      var wrapper = document.createElement('div');
      wrapper.className = 'mermaid';
      wrapper.style.cssText = 'display:flex;justify-content:center;margin:2rem 0;overflow-x:auto;';
      var raw = pre.textContent.trim();
      wrapper.textContent = raw;
      pre.parentNode.replaceChild(wrapper, pre);
      mermaid.render('mermaid-' + idx, raw).then(function(info) {
        wrapper.innerHTML = info.svg;
        var svg = wrapper.querySelector('svg');
        if (svg) {
          svg.style.width = '100%';
          svg.style.maxWidth = '900px';
          svg.style.height = 'auto';
        }
      }).catch(function(err) {
        console.error('Mermaid render error:', err.message);
        wrapper.innerHTML = '<pre style="color:#f871a71;padding:1rem;">Mermaid error: ' + err.message + '</pre>';
      });
    });
  }
</script>

<style>
  main {
    @apply mx-auto w-full max-w-3xl px-4 pb-12;
  }
  .post-title {
    @apply text-2xl font-semibold text-skin-accent;
  }
  .tags-container {
    @apply my-8;
  }
  .mermaid svg {
    background: transparent;
    max-width: 900px;
  }
</style>
