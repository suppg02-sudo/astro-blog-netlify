---
export interface Props {
  text: string;
  label?: string;
  className?: string;
}

const { text, label = "Copy", className = "" } = Astro.props;
---

<button
  type="button"
  class:list={["copy-btn", className]}
  data-copy={text}
  onclick="navigator.clipboard.writeText(this.dataset.copy).then(() => this.classList.add('copied'))"
>
  <span class="label">{label}</span>
  <span class="icon">📋</span>
  <span class="success">✓</span>
</button>

<style>
  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: var(--bg-secondary, #1e293b);
    border: 1px solid var(--border-color, #334155);
    border-radius: 0.375rem;
    color: var(--text-primary, #e2e8f0);
    font-size: 0.875rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .copy-btn:hover {
    background: var(--bg-hover, #334155);
    border-color: var(--accent-color, #3b82f6);
  }
  
  .copy-btn .success {
    display: none;
  }
  
  .copy-btn.copied .icon {
    display: none;
  }
  
  .copy-btn.copied .success {
    display: inline;
    color: #22c55e;
  }
  
  .copy-btn.copied {
    border-color: #22c55e;
  }
</style>
