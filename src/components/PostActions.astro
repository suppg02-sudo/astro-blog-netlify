---
export interface Props {
  postTitle: string;
  postSlug: string;
  postUrl: string;
  tags?: string[];
}

const { postTitle, postSlug, postUrl, tags = [] } = Astro.props;

const memoryCommand = `python3 ~/.config/opencode/scripts/capture_conversation.py "${postTitle}" --type conversation --tags "${tags.join(',')}"`;
const remindCommand = `reminder add "${postTitle}" --in 7d`;
const openCommand = `opencode ${postUrl}`;
---

<div class="post-actions">
  <h3 class="actions-title">🎯 Quick Actions</h3>
  <p class="actions-desc">Click to copy command, then paste in OpenCode terminal:</p>
  
  <div class="actions-grid">
    <div class="action-item">
      <span class="action-label">📋 Add to Memory</span>
      <button 
        class="copy-action-btn"
        data-copy={memoryCommand}
        onclick="navigator.clipboard.writeText(this.dataset.copy); this.classList.add('copied'); setTimeout(() => this.classList.remove('copied'), 2000)"
      >
        <span class="btn-text">Copy Command</span>
        <span class="btn-success">✓ Copied!</span>
      </button>
    </div>
    
    <div class="action-item">
      <span class="action-label">⏰ Remind Me (7 days)</span>
      <button 
        class="copy-action-btn"
        data-copy={remindCommand}
        onclick="navigator.clipboard.writeText(this.dataset.copy); this.classList.add('copied'); setTimeout(() => this.classList.remove('copied'), 2000)"
      >
        <span class="btn-text">Copy Command</span>
        <span class="btn-success">✓ Copied!</span>
      </button>
    </div>
    
    <div class="action-item">
      <span class="action-label">🔗 Copy Post URL</span>
      <button 
        class="copy-action-btn"
        data-copy={postUrl}
        onclick="navigator.clipboard.writeText(this.dataset.copy); this.classList.add('copied'); setTimeout(() => this.classList.remove('copied'), 2000)"
      >
        <span class="btn-text">Copy URL</span>
        <span class="btn-success">✓ Copied!</span>
      </button>
    </div>
    
    <div class="action-item">
      <span class="action-label">📂 Open in Editor</span>
      <button 
        class="copy-action-btn"
        data-copy={`http://ubuntu4:8080/editor/docker/astro-blog/src/content/blog/${postSlug}.md`}
        onclick="navigator.clipboard.writeText(this.dataset.copy); this.classList.add('copied'); setTimeout(() => this.classList.remove('copied'), 2000)"
      >
        <span class="btn-text">Copy Link</span>
        <span class="btn-success">✓ Copied!</span>
      </button>
    </div>
  </div>
  
  <details class="advanced-actions">
    <summary>🔧 Advanced Commands</summary>
    <div class="code-blocks">
      <div class="code-block">
        <span class="code-label">Search related in memory:</span>
        <code onclick="navigator.clipboard.writeText(this.textContent)">pghmem search "${tags[0] || postTitle}"</code>
      </div>
      <div class="code-block">
        <span class="code-label">Create skill from this:</span>
        <code onclick="navigator.clipboard.writeText(this.textContent)">sf</code>
      </div>
      <div class="code-block">
        <span class="code-label">Check related skills:</span>
        <code onclick="navigator.clipboard.writeText(this.textContent)">skill-discovery</code>
      </div>
    </div>
  </details>
</div>

<style>
  .post-actions {
    margin-top: 2rem;
    padding: 1.5rem;
    background: var(--bg-secondary, #1e293b);
    border: 1px solid var(--border-color, #334155);
    border-radius: 0.5rem;
  }
  
  .actions-title {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--text-primary, #e2e8f0);
  }
  
  .actions-desc {
    font-size: 0.875rem;
    color: var(--text-muted, #94a3b8);
    margin-bottom: 1rem;
  }
  
  .actions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 0.75rem;
  }
  
  .action-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .action-label {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary, #cbd5e1);
  }
  
  .copy-action-btn {
    padding: 0.5rem 0.75rem;
    background: var(--bg-tertiary, #0f172a);
    border: 1px solid var(--border-color, #334155);
    border-radius: 0.375rem;
    color: var(--text-primary, #e2e8f0);
    font-size: 0.8rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .copy-action-btn:hover {
    border-color: var(--accent-color, #3b82f6);
    background: var(--bg-hover, #1e293b);
  }
  
  .copy-action-btn .btn-success {
    display: none;
    color: #22c55e;
  }
  
  .copy-action-btn.copied .btn-text {
    display: none;
  }
  
  .copy-action-btn.copied .btn-success {
    display: inline;
  }
  
  .copy-action-btn.copied {
    border-color: #22c55e;
  }
  
  .advanced-actions {
    margin-top: 1rem;
  }
  
  .advanced-actions summary {
    cursor: pointer;
    font-size: 0.875rem;
    color: var(--text-muted, #94a3b8);
    padding: 0.5rem 0;
  }
  
  .advanced-actions summary:hover {
    color: var(--text-primary, #e2e8f0);
  }
  
  .code-blocks {
    margin-top: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .code-block {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  
  .code-label {
    font-size: 0.75rem;
    color: var(--text-muted, #94a3b8);
  }
  
  .code-block code {
    padding: 0.25rem 0.5rem;
    background: var(--bg-tertiary, #0f172a);
    border-radius: 0.25rem;
    font-size: 0.75rem;
    cursor: pointer;
    transition: all 0.2s;
  }
  
  .code-block code:hover {
    background: var(--accent-color, #3b82f6);
  }
</style>
